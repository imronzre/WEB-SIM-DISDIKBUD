# Environment Variables Supabase untuk SIM-PAUDNI Kabupaten Boyolali
# Dapatkan nilai ini dari Dashboard Supabase Anda: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key HANYA digunakan di server-side (Server Actions / Admin Route)
# JANGAN PERNAH menyertakan NEXT_PUBLIC_ pada variabel ini demi keamanan!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
